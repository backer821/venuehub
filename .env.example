# Copy this file to .env.local and fill in real values.

# PostgreSQL connection string used by drizzle-orm and drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/venuehub_db

# Secret used to sign session JWTs. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to "true" to allow POST /api/seed to run when NODE_ENV=production.
# Leave unset in real production deployments.
ALLOW_SEED=false
